{
  "compilerOptions": {
    "target": "ES2022", // Nutzt moderne JS-Features wie top-level await
    "module": "nodenext", // Ermöglicht ESM-Output
    "moduleResolution": "NodeNext", // Richtige Auflösung für ESM/CJS
    "lib": [
      "ES2022"
    ],
    "declaration": true, // Für .d.ts-Generierung
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true, // Für find-my-way & andere CJS-Module
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true, // tsup übernimmt das Emitting
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test",
    "example",
    "**/*.test.ts",
    "benchmark"
  ]
}